#!/usr/bin/env ruby
require 'fileutils'

FileUtils.chdir File.expand_path('..', __dir__) do
  system('bundle', 'check') || system('bundle', 'install', exception: true)
  system('bin/rails', 'db:prepare', exception: true)
  system({ 'RAILS_ENV' => 'test', 'TEST_DB_DATABASE' => ENV.fetch('TEST_DB_DATABASE', 'ledgerly_test') }, 'bin/rails',
         'db:prepare', exception: true)
  exec 'bin/dev' unless ARGV.include?('--skip-server')
end
