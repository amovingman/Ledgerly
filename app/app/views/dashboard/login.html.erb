<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Sign in · Ledgerly</title>
  <%= csrf_meta_tags %>
  <link rel="icon" href="/dashboard-assets/mark.svg?v=1" type="image/svg+xml">
  <link rel="stylesheet" href="/dashboard-assets/dashboard.css?v=1">
</head>
<body class="login-page">
  <main class="login-shell">
    <a class="brand" href="/dashboard/login"><img src="/dashboard-assets/mark.svg?v=1" alt="" width="28" height="28"><span>Ledgerly</span></a>
    <div class="login-book" aria-hidden="true"><span>Debit</span><span>Credit</span><div></div><div></div></div>
    <h1>A clearer view of your billing.</h1>
    <p class="login-intro">Inspect customers, metered usage and every side of the ledger.</p>
    <% if @error %><p class="form-error" role="alert"><%= @error %></p><% end %>
    <%= form_with url: dashboard_session_path, method: :post, local: true, class: 'login-form' do %>
      <label for="password">Ledgerly access key</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required autofocus aria-describedby="key-help">
      <p id="key-help" class="help-text">Use the API access key configured for this Ledgerly instance.</p>
      <button class="button primary" type="submit">Open dashboard <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></button>
    <% end %>
    <div class="login-foot"><span class="read-dot"></span> Read-only access <span>·</span> Stripe test mode</div>
  </main>
</body>
</html>
