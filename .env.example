# Copy to .env. Generate a local API key with: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
# Keep .env ignored; never use this example as a source of production credentials.
API_KEY=

# Local development values. Compose uses internal postgres/redis hostnames.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ledgerly_development
DB_USERNAME=ledgerly
DB_PASSWORD=ledgerly_local
REDIS_URL=redis://127.0.0.1:6379/0
RAILS_MAX_THREADS=5
PORT=3000
